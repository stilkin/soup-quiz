# EAS uploads this list INSTEAD of .gitignore (add-tester-build design D4), so it
# must enumerate all build noise itself — plus repo-only trees the app build never
# needs. eas-cli resolves this file at the GIT ROOT and evaluates patterns from
# there (verified against eas-cli 23.2.0 build/vcs/clients/git.js), hence the
# repo-root anchoring: /data must not swallow packages/data.
/.git
/.claude
/openspec
/data
node_modules/
.pnpm-store/
dist/
.expo/
.venv/
__pycache__/
*.tsbuildinfo
*.pyc
.DS_Store
