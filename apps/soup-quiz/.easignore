# EAS uploads this list INSTEAD of .gitignore (add-tester-build design D4),
# so it must enumerate all build noise itself — plus repo-only trees the app
# build never needs. Patterns are anchored (/) where a bare name would also
# match inside packages/ (notably /data vs packages/data).
/.git
/.claude
/openspec
/data
node_modules/
.pnpm-store/
dist/
.expo/
.venv/
__pycache__/
*.tsbuildinfo
*.pyc
.DS_Store
