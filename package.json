{
  "name": "soup-quiz-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "start": "pnpm --filter @soup-quiz/app start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:py": "data/pipeline/.venv/bin/ruff check data/pipeline",
    "typecheck:py": "data/pipeline/.venv/bin/mypy --config-file data/pipeline/pyproject.toml data/pipeline",
    "test:py": "data/pipeline/.venv/bin/pytest data/pipeline"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
